# ============================================================
# ApneNews — Environment Configuration
# Copy this file to `.env` and fill in real values.
# The platform RUNS WITHOUT any API keys using deterministic
# fallback providers; keys unlock real AI / image / social output.
# ============================================================

# ---- Core ----
# Public base URL of the site (used for canonical URLs, sitemaps, RSS)
APP_URL="http://localhost:3000"
NODE_ENV="development"

# ---- Database ----
# SQLite (zero-config dev default):
DATABASE_URL="file:./dev.db"
# PostgreSQL (production):
# DATABASE_URL="postgresql://user:password@localhost:5432/apnenews?schema=public"
# Set to "postgresql" when using Postgres, otherwise "sqlite"
DATABASE_PROVIDER="sqlite"

# ---- Auth ----
# Secret used to sign admin session cookies (generate: openssl rand -hex 32)
AUTH_SECRET="change-me-to-a-long-random-string"
# Seed super-admin credentials (used by `npm run db:seed`)
ADMIN_EMAIL="admin@apnenews.local"
ADMIN_PASSWORD="ChangeMe123!"

# ---- Automation / Cron security ----
# Bearer token required to trigger cron endpoints (/api/cron/*)
CRON_SECRET="change-me-cron-secret"

# ---- AI Provider ----
# Provider: "mock" (default, no key needed) | "anthropic" | "openai"
AI_PROVIDER="mock"
AI_API_KEY=""
AI_MODEL="claude-sonnet-4-5"
# Approx cost per 1K tokens in INR for the cost estimator
AI_COST_PER_1K_INR="1.20"

# ---- News Provider (optional external aggregator API) ----
# Provider: "rss" (default, uses configured RSS sources) | "newsapi"
NEWS_PROVIDER="rss"
NEWS_API_KEY=""

# ---- Image Provider ----
# Provider: "placeholder" (default, deterministic SVG) | "unsplash" | "ai"
IMAGE_PROVIDER="placeholder"
IMAGE_API_KEY=""

# ---- Telegram (optional) ----
TELEGRAM_ENABLED="false"
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHANNEL_ID=""

# ---- Social (optional) ----
SOCIAL_FACEBOOK_ENABLED="false"
SOCIAL_TWITTER_ENABLED="false"

# ---- Analytics (optional) ----
ANALYTICS_ID=""

# ---- Publishing defaults (also editable in Admin > Automation) ----
DAILY_MIN_ARTICLES="50"
DAILY_MAX_ARTICLES="60"
PUBLISH_INTERVAL_MINUTES="15"
FETCH_INTERVAL_MINUTES="15"
AUTO_PUBLISH_CONFIDENCE="85"
REVIEW_CONFIDENCE="65"
